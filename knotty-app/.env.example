# Public project connection values. Use the publishable key for new projects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional compatibility for projects still using the legacy anon key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Server only; required only for trusted administrative operations.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Google OAuth Credentials for Supabase Auth
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
