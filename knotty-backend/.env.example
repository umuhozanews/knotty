
DATABASE_URL="postgresql://user:password@localhost:5432/knotty_db?schema=public"

REDIS_URL="redis://localhost:6379"

JWT_SECRET="your-super-secret-jwt-key-change-this-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AES-256-GCM key for field-level encryption of medical data.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-64-hex-character-encryption-key-here"

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_SUBSCRIPTION_KEY="your-subscription-key"
MTN_MOMO_API_USER="your-api-user-uuid"
MTN_MOMO_API_KEY="your-api-key"
MTN_MOMO_ENVIRONMENT="sandbox"
MTN_MOMO_CALLBACK_URL="https://your-domain.com/api/v1/fees/verify/webhook"
MOMO_CALLBACK_SECRET="your-momo-webhook-secret-min-32-chars"

# Vercel Cron secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="your-64-hex-cron-secret"

# Sentry DSN for error monitoring (optional in local dev)
SENTRY_DSN=""

AFRICAS_TALKING_API_KEY="your-at-api-key"
AFRICAS_TALKING_USERNAME="sandbox"
AFRICAS_TALKING_SENDER_ID="KNOTTY"

# App
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# QR Code
QR_BASE_URL="https://your-domain.com"
